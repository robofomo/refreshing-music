  "segments": [
    {
      "t0Ms": 31,
      "t1Ms": 3645,
      "text": "Everybody, everybody, everybody, lend a hand if you wanna"
    },
    {
      "t0Ms": 19252,
      "t1Ms": 34375,
      "text": "We roll the dice, the screen lights up A hundred tries, we still show up Same old joke, but told anew The punchline lands because it's you From late night chats to morning cold We pass the spark, we share the load It loops around, it never ends, a glitch that's"
    },
    {
      "t0Ms": 60730,
      "t1Ms": 84477,
      "text": "Archive days we almost lost Small mistakes at zero cost Every echo finds its place In the rhythm that we chase Strip it down, just hands and feet Hobby claps the human beat Let it breathe and pull it tight Cue the groove and bring the light It refreshed, don't fade it out Laugh it back, that's what we're about"
    },
    {
      "t0Ms": 114022,
      "t1Ms": 127727,
      "text": "Run it again Hit refresh, run it again Hit refresh, run it again Hit refresh Everybody lemme hug your buddy"
    },
    {
      "t0Ms": 143705,
      "t1Ms": 144250,
      "text": "you"
    }
