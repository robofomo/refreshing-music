{
  "Version": "v2.2",
  "SectionVocalPolicy": {
    "_Comment": "Defines whether sung lyrics are allowed in specific sections, and how often. This is a permission+shape layer (not theme taste).",
    "Defaults": {
      "Intro": {
        "DefaultMode": "instrumental_only",
        "AllowLyricsChance": 0.22,
        "MaxLyricLines": 1,
        "AllowedLyricForms": ["hook_echo", "mantra", "single_line_statement"],
        "SungTextRule": "If lyrics are allowed and chosen, sung text MUST be outside brackets; all non-sung content MUST be in brackets."
      },
      "Ending": {
        "DefaultMode": "lyrical_ok",
        "AllowLyricsChance": 0.55,
        "MaxLyricLines": 2,
        "AllowedLyricForms": ["hook_echo", "refrain_tag", "mantra"],
        "SungTextRule": "If lyrical, prefer a short tag/echo; do not introduce new story content."
      },
      "Outro": {
        "DefaultMode": "instrumental_only",
        "AllowLyricsChance": 0.12,
        "MaxLyricLines": 1,
        "AllowedLyricForms": ["hook_echo", "adlib_phrase", "wordless_vocal"],
        "SungTextRule": "If lyrical, keep it minimal; may be a single repeated phrase or wordless vocal."
      },
      "IntroType_instrumental": {
        "_Comment": "Clarifies that IntroType is an arrangement default, not a hard lyric ban.",
        "Meaning": "Instrumental arrangement default; lyrical Intro is permitted only if SectionVocalPolicy allows it."
      }
    },
    "VocalModeMultipliers": {
      "_Comment": "Optional: scales AllowLyricsChance based on chosen VocalMode. Applied in Core (not enforced by this file).",
      "instrumental": 0.25,
      "textural": 0.70,
      "sparse": 1.00,
      "full": 1.25
    }
  },

  "StructurePatterns": [
    {
      "PatternId": "verse_chorus_instrumental_intro",
      "Label": "Verse/Chorus (Instrumental Intro)",
      "Sections": ["Intro", "Verse", "Verse", "Chorus", "Verse", "Bridge", "Final Chorus", "Ending"],
      "Defaults": {
        "IntroType": "instrumental",
        "LineCounts": { "Intro": 2, "Verse": 4, "Chorus": 4, "Bridge": 4, "Final Chorus": 4, "Ending": 2 }
      },
      "AllowedEvents": { "StyleChangeAt": ["Bridge"], "ModulationAt": ["Final Chorus"], "TempoChangeAt": ["Bridge"] },
      "SectionVocalOverride": { "Ending": { "AllowLyricsChance": 0.60, "MaxLyricLines": 2 } }
    },

    {
      "PatternId": "verse_prechorus_chorus",
      "Label": "Verse/Pre-Chorus/Chorus",
      "Sections": ["Intro", "Verse", "Pre-Chorus", "Chorus", "Verse", "Bridge", "Final Chorus", "Ending"],
      "Defaults": {
        "IntroType": "instrumental",
        "LineCounts": { "Intro": 2, "Verse": 4, "Pre-Chorus": 2, "Chorus": 4, "Bridge": 4, "Final Chorus": 4, "Ending": 2 }
      },
      "AllowedEvents": { "StyleChangeAt": ["Bridge"], "ModulationAt": ["Final Chorus"], "TempoChangeAt": ["Bridge"] },
      "SectionVocalOverride": { "Ending": { "AllowLyricsChance": 0.62, "MaxLyricLines": 2 } }
    },

    {
      "PatternId": "verse_prechorus_chorus_postchorus",
      "Label": "Verse/Pre-Chorus/Chorus/Post-Chorus",
      "Sections": ["Intro", "Verse", "Pre-Chorus", "Chorus", "Post-Chorus", "Verse", "Bridge", "Final Chorus", "Post-Chorus", "Ending"],
      "Defaults": {
        "IntroType": "instrumental",
        "LineCounts": { "Intro": 2, "Verse": 4, "Pre-Chorus": 2, "Chorus": 4, "Post-Chorus": 2, "Bridge": 4, "Final Chorus": 4, "Ending": 2 }
      },
      "AllowedEvents": { "StyleChangeAt": ["Bridge"], "ModulationAt": ["Final Chorus"], "TempoChangeAt": ["Bridge"] },
      "SectionVocalOverride": { "Ending": { "AllowLyricsChance": 0.62, "MaxLyricLines": 2 } }
    },

    {
      "PatternId": "groove_song",
      "Label": "Groove Song",
      "Sections": ["Intro", "Verse", "Verse", "Chorus", "Verse", "Chorus", "Outro"],
      "Defaults": {
        "IntroType": "instrumental",
        "LineCounts": { "Intro": 2, "Verse": 4, "Chorus": 4, "Outro": 2 }
      },
      "AllowedEvents": { "StyleChangeAt": ["Outro"], "ModulationAt": ["Chorus"], "TempoChangeAt": [] },
      "SectionVocalOverride": { "Outro": { "AllowLyricsChance": 0.22, "MaxLyricLines": 1, "AllowedLyricForms": ["hook_echo", "adlib_phrase"] } }
    },

    {
      "PatternId": "cinematic_build",
      "Label": "Cinematic Build",
      "Sections": ["Intro", "Verse", "Verse", "Bridge", "Chorus", "Final Chorus", "Ending"],
      "Defaults": {
        "IntroType": "instrumental",
        "LineCounts": { "Intro": 2, "Verse": 4, "Bridge": 4, "Chorus": 4, "Final Chorus": 4, "Ending": 2 }
      },
      "AllowedEvents": { "StyleChangeAt": ["Bridge"], "ModulationAt": ["Final Chorus"], "TempoChangeAt": [] },
      "SectionVocalOverride": { "Ending": { "AllowLyricsChance": 0.70, "MaxLyricLines": 2, "AllowedLyricForms": ["single_line_statement", "refrain_tag", "hook_echo"] } }
    },

    {
      "PatternId": "instrumental_thematic_dev",
      "Label": "Instrumental Thematic Development",
      "Sections": ["Intro", "Theme", "Variation", "Solo", "Return", "Ending"],
      "Defaults": { "IntroType": "instrumental", "MeasuresPerSection": 4 },
      "AllowedEvents": { "StyleChangeAt": ["Variation"], "ModulationAt": ["Return"], "TempoChangeAt": [] },
      "SectionVocalOverride": { "Ending": { "AllowLyricsChance": 0.18, "MaxLyricLines": 1, "AllowedLyricForms": ["hook_echo", "wordless_vocal"] } }
    },

    {
      "PatternId": "structural_experiment",
      "Label": "Structural Experiment",
      "Sections": ["Intro", "Fragment A", "Reset", "Fragment B", "Bridge", "Final Chorus", "Ending"],
      "Defaults": {
        "IntroType": "instrumental",
        "LineCounts": { "Intro": 2, "Fragment A": 2, "Reset": 2, "Fragment B": 2, "Bridge": 4, "Final Chorus": 4, "Ending": 2 }
      },
      "AllowedEvents": { "StyleChangeAt": ["Reset", "Bridge"], "ModulationAt": ["Final Chorus"], "TempoChangeAt": ["Reset"] },
      "SectionVocalOverride": {
        "Intro": { "AllowLyricsChance": 0.30, "MaxLyricLines": 1, "AllowedLyricForms": ["single_line_statement", "mantra"] },
        "Ending": { "AllowLyricsChance": 0.65, "MaxLyricLines": 2 }
      }
    }
  ],

  "Mutations": [
    { "MutationId": "instrumental_break", "Label": "Instrumental Break", "Weight": 2.0 },
    { "MutationId": "strip_chorus_once", "Label": "Stripped Chorus Once", "Weight": 1.2 },
    { "MutationId": "breakdown_bridge", "Label": "Breakdown Bridge", "Weight": 1.2 },
    { "MutationId": "final_chorus_extend", "Label": "Final Chorus Extend", "Weight": 1.1 },
    { "MutationId": "dropout_before_final", "Label": "Dropout Before Final", "Weight": 1.1 },

    { "MutationId": "micro_variation_loop", "Label": "Micro-Variation Loop Evolution", "Weight": 1.3 },
    { "MutationId": "call_response_backing", "Label": "Call & Response Backing", "Weight": 1.2 },
    { "MutationId": "modular_section_swap", "Label": "Modular Section Swap Feel", "Weight": 1.0 }
  ],

  "MelodicConcepts": [
    "conversational contour",
    "asymmetric phrasing",
    "call-and-answer hook",
    "stepwise triad stairs",
    "motif rotation",
    "register swap",
    "long-tone release",
    "gentle sequence",
    "rhythmic displacement",
    "counter-melody braid"
  ],

  "HookProminenceWeights": { "low": 1.0, "medium": 2.0, "high": 1.2 },

  "PoeticPatternWeights": {
    "meter": { "iambic tetrameter": 7.0, "iambic pentameter": 3.0 },
    "rhyme": { "AABB": 8.0, "ABAB": 2.0 }
  }
}
