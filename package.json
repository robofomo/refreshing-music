{
  "name": "gen-music-visualizer",
  "private": true,
  "scripts": {
    "import:inbox": "node tools/import-inbox-runner.mjs",
    "import:inbox:raw": "node tools/import-inbox.mjs",
    "import:inbox:smoke": "node tools/smoke-import-inbox.mjs",
    "idgen": "node tools/id-gen.mjs",
    "preprocess": "node tools/batch-preprocess.mjs",
    "stems": "node tools/run-stems.mjs",
    "beats": "node tools/run-beats.mjs",
    "whisperx": "node tools/run-whisperx.mjs",
    "preprocess:ai": "node tools/preprocess-ai.mjs",
    "composer:lint": "node tools/lint-composer.mjs",
    "repair:lyrics": "node tools/repair-lyrics-timing.mjs",
    "reduce:effective": "node tools/reduce-effective-all.mjs",
    "build:release": "node tools/reduce-effective-all.mjs && npm --workspace apps/dev-viewer run build:release",
    "build:package": "node tools/build-release-package.mjs",
    "dev": "npm --workspace apps/dev-viewer run dev",
    "recipes:validate": "node --input-type=module --eval \"import('./packages/recipes/resolveRecipe.mjs').then(m=>m.resolveRecipe({ albumId:'example-theme' })).then(r=>console.log(r.recipeId))\"",
    "audio:normalize-cbr": "node tools/normalize-mp3-cbr.mjs --root assets --kbps 160",
    "sections:export": "node tools/export-section-markers.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "yauzl": "^2.10.0"
  }
}
