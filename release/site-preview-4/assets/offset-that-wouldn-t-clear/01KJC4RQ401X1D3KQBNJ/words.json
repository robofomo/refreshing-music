  "segments": [
    {
      "t0Ms": 18104,
      "t1Ms": 35522,
      "text": "I lined it up, I checked it twice Still something slipped between The number said it should be fine But that's not what I'm seeing There wasn't wrong enough to fail It wasn't wrong enough to pass So it stayed inside the system Like a question I can't ask"
    },
    {
      "t0Ms": 41830,
      "t1Ms": 51570,
      "text": "I tried to hold it back again But every copy kept a scar The fix just taught the fall Exactly where the limits are"
    },
    {
      "t0Ms": 90650,
      "t1Ms": 117383,
      "text": "It doesn't crash, it doesn't end It just repeats another way Like something learned the wrong lesson And refuses to unlearn the day Fuses to unlearn the day I stopped trying to correct it Let the fault define the frame If it runs, it runs imperfect But it runs the same"
    },
    {
      "t0Ms": 119388,
      "t1Ms": 122968,
      "text": "From the same"
    }
  ],
